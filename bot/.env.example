# Copy to .env (chmod 600). Never commit .env.
# LLM keys: pay-as-you-go API keys (coding-plan keys are not allowed for bots). The live bot uses the first one set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ZAI_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5   # with its $ per 1M tokens:
# OPENROUTER_PRICE_IN=0.10
# OPENROUTER_PRICE_OUT=0.50
# Discord alerts: channel settings > Integrations > Webhooks > New webhook > Copy URL
DISCORD_WEBHOOK_URL=
# Binance live key: Futures enabled, withdrawals OFF, IP whitelist = 5.189.155.78
BINANCE_API_KEY=
BINANCE_API_SECRET=
# LIVE_CONFIRM=I-ACCEPT-REAL-MONEY
# FLOOR_EQUITY=70   # full stop below this equity (USDT); 12 for the 18 USDT test month
# Dashboard login (https://trade.brandondev.online), password 16+ chars
DASH_USER=brandon
DASH_PASSWORD=
# Dashboard / ownership (bot numbers start here; owner hand trades before/without the bot prefix are excluded)
# BOT_START=2026-11-27T06:25:00Z
# START_FUTURES=18.7392
# LLM_CREDIT=2.0
# LLM_USAGE_BASELINE=0.00267
# v2 (paper arms only until the owner's separate go): STRATEGY=v1 (default, live) | v2, ARM=signal | committee
# STRATEGY=v1
# ARM=signal
# SIGNAL=            # empty = best_signal() from the backtest gate, else breakout
# RISK_PCT=0.02      # hard cap until >= 30 closed v2 trades average >= +0.10 R net
# RISK_PCT_PROVEN=0.03
# UNIVERSE_N=10
# PAPER_START=18.7392
# FLOOR_EQUITY_PAPER=12
# LLM_DAILY_USD=0.10 # committee cost cap per UTC day
